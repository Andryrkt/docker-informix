# Copier ce fichier en .env.prod (jamais commite) et renseigner les vraies valeurs
# sur le serveur de production. Consomme par le service backend via env_file
# dans docker-compose.prod.yml.

APP_ENV=prod
APP_SECRET=
APP_SHARE_DIR=var/share
ADMIN_EMAIL=
DEFAULT_URI=
CORS_ALLOW_ORIGIN=

INFORMIXSERVER=ol_iriumprod_net
INFORMIX_HOST=192.168.0.11
INFORMIX_PORT=
INFORMIX_DB=
INFORMIX_DB_IRIUM=
INFORMIX_USER=
INFORMIX_PASSWORD=

SQLSERVER_HOST=
SQLSERVER_PORT=
SQLSERVER_DB=
SQLSERVER_USER=
SQLSERVER_PASSWORD=

LDAP_URL=
LDAP_DOMAIN=
LDAP_BASE_DN=
LDAP_SEARCH_DN=
LDAP_SEARCH_PASSWORD=

# Le couple de cles JWT n'est pas commite dans le repo (config/jwt/*.pem est
# gitignore). Il doit etre genere/fourni separement sur le serveur de prod
# (ou injecte pendant le deploiement), sinon l'authentification API cassera.
JWT_PASSPHRASE=
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem

MAILER_DSN=
MAILER_FROM=
