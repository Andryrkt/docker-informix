# ============================================================
### 1. Login
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

# ============================================================
### 2. Profil /me  (envoyer après le login)
GET {{baseUrl}}/me
Authorization: Bearer {{token}}

# ============================================================
### 3. Login mauvais mot de passe — doit retourner 401
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "mauvais_motdepasse"
}

# ============================================================
### 4. /me sans token — doit retourner 401
GET {{baseUrl}}/me

# ============================================================
### 5. Navigation
GET {{baseUrl}}/navigation
Authorization: Bearer {{token}}
